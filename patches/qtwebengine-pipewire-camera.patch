 #include "base/no_destructor.h"
 #include "base/path_service.h"
 #include "base/strings/string_number_conversions.h"
@@ -35,6 +36,7 @@
 #if BUILDFLAG(IS_LINUX)
 #include "media/audio/audio_manager.h"
 #include "ui/base/ui_base_switches.h"
+#include "services/video_capture/public/mojom/video_capture_service.mojom.h"
 #endif
 
 #if BUILDFLAG(IS_WIN)
@@ -48,9 +50,12 @@
 #endif
 
 #include <QtCore/qcoreapplication.h>
+#include <QtCore/qabstracteventdispatcher.h>
 
 namespace QtWebEngineCore {
 
+extern std::unique_ptr<base::MessagePump> childProcessMessagePumpFactory();
+
 namespace {
 
 // The logic of this function is based on chrome/common/net/net_resource_provider.cc
@@ -167,6 +172,22 @@ void ContentMainDelegateQt::PreSandboxStartup()
 #endif
     }
 
+#if BUILDFLAG(IS_LINUX)
+    // The PipeWire camera WebRTC process is a utility process that is started with
+    // a message loop (--message-loop-type-ui), which is used for the gdbus based
+    // portal communication. As Chromium is built without glib support, there is no
+    // usable event loop for this child process available and we need to provide a
+    // "MessagePumpForUIQt" style pump that provides one.
+    const bool isVideoCaptureService = parsedCommandLine->GetSwitchValueASCII(switches::kProcessType) == switches::kUtilityProcess
+        && parsedCommandLine->GetSwitchValueASCII(switches::kUtilitySubType) == video_capture::mojom::VideoCaptureService::Name_;
+    if (isVideoCaptureService
+        && parsedCommandLine->HasSwitch(switches::kMessageLoopTypeUi)
+        && QAbstractEventDispatcher::instance()
+        && QAbstractEventDispatcher::instance()->inherits("QEventDispatcherGlib")) {
+        base::MessagePump::OverrideMessagePumpForUIFactory(childProcessMessagePumpFactory);
+    }
+#endif
+
     if (parsedCommandLine->HasSwitch(switches::kApplicationName)) {
         std::string appName = parsedCommandLine->GetSwitchValueASCII(switches::kApplicationName);
         appName = QByteArray::fromPercentEncoding(QByteArray::fromStdString(appName)).toStdString();
