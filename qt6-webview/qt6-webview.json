{
    "name": "qt6-webview",
    "buildsystem": "cmake-ninja",
    "builddir": true,
    "build-options": {
        "arch": {
            "aarch64": {
                "config-opts": [
                    "-D_qt_additional_packages_prefix_paths=/app/lib/aarch64-linux-gnu/cmake"
                ]
            },
            "x86_64": {
                "config-opts": [
                    "-D_qt_additional_packages_prefix_paths=/app/lib/x86_64-linux-gnu/cmake"
                ]
            }
        }
    },
    "sources": [
        {
            "type": "archive",
            "url": "https://files.kde.org/qt/official_releases/qt/6.12/6.12.0/submodules/qtwebview-everywhere-src-6.12.0.tar.xz",
            "sha256": "bee0642225614d7fc9486a2ca6db7d2c82a28c311404d1503185a360792c504e",
            "x-checker-data": {
                "type": "anitya",
                "project-id": 7927,
                "stable-only": false,
                "versions": {
                    "<": "6.13.0"
                }, 
                "url-template": "https://files.kde.org/qt/official_releases/qt/6.12/$version/submodules/qtlanguageserver-everywhere-src-$version.tar.xz"
            }
        },
        {
            "type": "shell",
            "commands": [
                "sed -i '/find_package(Qt6/ s/${PROJECT_VERSION}/${PROJECT_VERSION_MAJOR}.${PROJECT_VERSION_MINOR}/' $(find . -name CMakeLists.txt)"
            ]
        }
    ]
}
