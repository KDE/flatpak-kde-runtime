{
    "name": "pyside-setup",
    "buildsystem": "simple",
    "build-options": {
        "append-path": "/usr/lib/sdk/llvm22/bin",
        "append-ld-library-path": "/usr/lib/sdk/llvm22/lib"
    },
    "build-commands": [
        "LLVM_INSTALL_DIR=\"$(llvm-config --prefix)\" python3 setup.py build --qtpaths=/usr/bin/qtpaths --ignore-git --parallel=8 --log-level=verbose --flatpak --no-strip",
        "python3 create_wheels.py --build-dir ./build/qfp-*-release --no-examples",
        "pip3 install --no-index --no-deps --prefix=${FLATPAK_DEST} ./dist/*.whl",
        "(cd \"${INSTALL_ROOT:-}${FLATPAK_DEST}\"/lib/python3*/site-packages/PySide6 && libexecs=\"$(qtpaths --query QT_INSTALL_LIBEXECS)\" && for tool in Qt/libexec/*; do ln -sf \"${libexecs}/${tool##*/}\" \"${tool}\"; done)",
        "(cd \"${INSTALL_ROOT:-}${FLATPAK_DEST}\"/lib/python3*/site-packages/PySide6 && bins=\"$(qtpaths --query QT_INSTALL_BINS)\" && for tool in assistant balsam balsamui designer linguist lrelease lupdate qmlformat qmllint qmlls qsb svgtoqml; do if [ -f \"${tool}\" ]; then ln -sf \"${bins}/${tool}\" \"${tool}\"; fi; done)",
        "mkdir -p \"${INSTALL_ROOT:-}$(qtpaths --query QT_INSTALL_LIBS)\"",
        "cp -a \"$(llvm-config --libdir)\"/libLLVM.so* \"$(llvm-config --libdir)\"/libclang-cpp.so* \"$(llvm-config --libdir)\"/libclang.so* \"${INSTALL_ROOT:-}$(qtpaths --query QT_INSTALL_LIBS)/\""
    ],
    "cleanup-platform": [
        "/bin/pyside6-android-deploy",
        "/bin/pyside6-assistant",
        "/bin/pyside6-balsam",
        "/bin/pyside6-balsamui",
        "/bin/pyside6-deploy",
        "/bin/pyside6-designer",
        "/bin/pyside6-genpyi",
        "/bin/pyside6-linguist",
        "/bin/pyside6-lrelease",
        "/bin/pyside6-lupdate",
        "/bin/pyside6-metaobjectdump",
        "/bin/pyside6-project",
        "/bin/pyside6-qml",
        "/bin/pyside6-qmlcachegen",
        "/bin/pyside6-qmlformat",
        "/bin/pyside6-qmlimportscanner",
        "/bin/pyside6-qmllint",
        "/bin/pyside6-qmlls",
        "/bin/pyside6-qmltyperegistrar",
        "/bin/pyside6-qsb",
        "/bin/pyside6-qtpy2cpp",
        "/bin/pyside6-rcc",
        "/bin/pyside6-svgtoqml",
        "/bin/shiboken6",
        "/lib/python*/site-packages/shiboken6_generator*",
        "/lib/python*/site-packages/PySide6/include",
        "/lib/python*/site-packages/shiboken6/include",
        "/lib/python*/site-packages/PySide6/*.pyi",
        "/lib/python*/site-packages/shiboken6/*.pyi",
        "/lib/python*/site-packages/PySide6/typesystems",
        "/lib/python*/site-packages/PySide6/glue",
        "/lib/python*/site-packages/PySide6/Qt/metatypes",
        "/lib/python*/site-packages/PySide6/Qt/modules",
        "/lib/python*/site-packages/PySide6/scripts/*_lib",
        "/lib/python*/site-packages/PySide6/scripts/android_deploy.py",
        "/lib/python*/site-packages/PySide6/scripts/deploy.py",
        "/lib/python*/site-packages/PySide6/scripts/metaobjectdump.py",
        "/lib/python*/site-packages/PySide6/scripts/project.py",
        "/lib/python*/site-packages/PySide6/scripts/qml.py",
        "/lib/python*/site-packages/PySide6/scripts/qtpy2cpp.py",
        "/lib/python*/site-packages/PySide6/scripts/requirements-android.txt",
        "/lib/libLLVM.so*",
        "/lib/libclang-cpp.so*",
        "/lib/libclang.so*",
        "/lib/*/libLLVM.so*",
        "/lib/*/libclang-cpp.so*",
        "/lib/*/libclang.so*"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://code.qt.io/pyside/pyside-setup.git",
            "tag": "v6.12.0",
            "commit": "f50facb83fc3dc5f3240c854668c7a6dd93871b2",
            "x-checker-data": {
                "type": "git",
                "tag-pattern": "^v(6\\.12\\.[0-9]+)$"
            }
        },
        {
            "type": "shell",
            "commands": [
                "install-licenses.sh"
            ]
        }
    ],
    "modules": [
        "python3-requirements.json"
    ]
}
