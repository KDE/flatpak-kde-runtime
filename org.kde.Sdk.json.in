        {
            "name": "qtwayland",
            "buildsystem": "cmake-ninja",
            "cleanup-platform": [
                "/bin"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.qt.io/development_releases/qt/6.12/6.12.0-beta2/submodules/qtwayland-everywhere-src-6.12.0-beta2.tar.xz",
