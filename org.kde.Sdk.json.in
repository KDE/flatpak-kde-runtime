            "sources": [
                {
                    "type": "archive",
                    "url": "https://files.kde.org/qt/official_releases/qt/6.11/6.11.3/submodules/qtwayland-everywhere-src-6.11.3.tar.xz",
                    "sha256": "7f6185eb6e7d75202c42dfaf18dc54ae96f2d9a7a265358d061a6f85366f6c97",
