            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.qt.io/official_releases/qt/6.11/6.11.0/submodules/qtwayland-everywhere-src-6.11.0.tar.xz",
                    "sha256": "e710e6e760f92922b86e4dd68f6bbe94ef6510919519d1b0068e874b5ad84d37",
