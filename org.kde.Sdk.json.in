                        "versions": {
                            "<": "6.13.0"
                        },
                        "url-template": "https://files.kde.org/qt/official_releases/qt/6.12/$version/submodules/qtshadertools-everywhere-src-$version.tar.xz"
                    }
                },
                {
                    "type": "shell",
                    "commands": [
                        "install-licenses.sh"
                    ]
                }
            ]
        },
        {
            "name": "qtlanguageserver",
            "buildsystem": "cmake-ninja",
            "cleanup-platform": [
                "/bin"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://files.kde.org/qt/official_releases/qt/6.12/6.12.0/submodules/qtlanguageserver-everywhere-src-6.12.0.tar.xz",
                    "sha256": "552119e37360c06c5fb0b54e91bbfdf8da5a80d2cb1441ef93e966eb3b7a426d",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 7927,
                        "stable-only": false,
                        "versions": {
                            "<": "6.13.0"
                        },
                        "url-template": "https://files.kde.org/qt/official_releases/qt/6.12/$version/submodules/qtlanguageserver-everywhere-src-$version.tar.xz"
                    }
                },
                {
                    "type": "shell",
                    "commands": [
                        "install-licenses.sh"
                    ]
                }
            ]
        },
        {
            "name": "qtdeclarative",
            "config-opts": [
                "-DQT_TOOL_COMMAND_WRAPPER_PATH=env"
            ],
            "buildsystem": "cmake-ninja",
            "cleanup-platform": [
                "/bin",
                "/lib/plugins/qmltooling",
                "/lib/libexec/qmlaotstats",
                "/lib/libexec/qmlcachegen",
                "/lib/libexec/qmlimportscanner",
                "/lib/libexec/qmljsrootgen",
                "/lib/libexec/qmltyperegistrar",
                "/lib/plugins/qmllint",
                "/lib/plugins/qmlls"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://files.kde.org/qt/official_releases/qt/6.12/6.12.0/submodules/qtdeclarative-everywhere-src-6.12.0.tar.xz",
                    "sha256": "311f3a2603e1973bb59baef9dfa740a376de713157d4782ee043681e889c9260",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 7927,
                        "stable-only": false,
                        "versions": {
                            "<": "6.13.0"
                        },
                        "url-template": "https://files.kde.org/qt/official_releases/qt/6.12/$version/submodules/qtdeclarative-everywhere-src-$version.tar.xz"
                    }
                },
                {
                    "type": "shell",
                    "commands": [
                        "install-licenses.sh"
                    ]
                }
            ]
        },
        {
            "name": "qtwebchannel",
            "buildsystem": "cmake-ninja",
            "cleanup-platform": [
                "/bin"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://files.kde.org/qt/official_releases/qt/6.12/6.12.0/submodules/qtwebchannel-everywhere-src-6.12.0.tar.xz",
                    "sha256": "9afdfb64855b33c1cc16a4fdce69a556876f0d5b9df79d88de7306ffa2dca327",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 7927,
                        "stable-only": false,
                        "versions": {
                            "<": "6.13.0"
                        },
                        "url-template": "https://files.kde.org/qt/official_releases/qt/6.12/$version/submodules/qtwebchannel-everywhere-src-$version.tar.xz"
                    }
                },
                {
                    "type": "shell",
                    "commands": [
                        "install-licenses.sh"
                    ]
                }
            ]
        },
        {
            "name": "qtpositioning",
            "buildsystem": "cmake-ninja",
            "cleanup-platform": [
                "/bin"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://files.kde.org/qt/official_releases/qt/6.12/6.12.0/submodules/qtpositioning-everywhere-src-6.12.0.tar.xz",
                    "sha256": "b060d410fac7413b05a0e7938bbf3325f7ad08d7df14af3956270f0696e76763",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 7927,
                        "stable-only": false,
                        "versions": {
                            "<": "6.13.0"
                        },
                        "url-template": "https://files.kde.org/qt/official_releases/qt/6.12/$version/submodules/qtpositioning-everywhere-src-$version.tar.xz"
                    }
                },
                {
                    "type": "shell",
                    "commands": [
                        "install-licenses.sh"
                    ]
                }
            ]
        },
        {
            "name": "qtwebengine",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "build-options": {
                "append-path": "/usr/lib/sdk/node26/bin",
                "env": [
                    "npm_config_nodedir=/usr/lib/sdk/node26"
                ]
            },
            "cleanup-platform": [
                "/lib/libexec/gn",
                "/lib/libexec/qwebengine_convert_dict",
                "/resources/qtwebengine_devtools_resources.pak"
            ],
            "config-opts": [
                "-DQT_FEATURE_webengine_kerberos=ON",
                "-DQT_FEATURE_webengine_proprietary_codecs=ON",
                "-DQT_FEATURE_webengine_system_ffmpeg=OFF",
                "-DQT_FEATURE_webengine_system_freetype=ON",
                "-DQT_FEATURE_webengine_system_icu=ON",
                "-DQT_FEATURE_webengine_system_libxml=ON",
                "-DQT_FEATURE_webengine_webrtc_pipewire=ON",
                "-DQT_FEATURE_webengine_system_re2=OFF",
                "-DQT_FEATURE_webenginedriver=OFF",
                "-DQT_FEATURE_qtpdf_build=ON",
                "-DQT_FEATURE_qtpdf_widgets_build=ON",
                "-DQT_FEATURE_qtpdf_quick_build=ON"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://invent.kde.org/qt/qt/qtwebengine.git",
                    "tag": "v6.140.0",
                    "commit": "e081473af432e2b09d17caa3ca3bffd45992a0bd",
                    "x-checker-data": {
                        "is-main-source": true,
                        "type": "json",
                        "url": "https://invent.kde.org/api/v4/projects/qt%2Fqt%2Fqtwebengine/repository/tags",
                        "tag-query": "first(.[].name | match( \"v6.[\\\\d.]+(-lts)?\" ) | .string)",
                        "version-query": "$tag | sub(\"^v\"; \"\")",
                        "timestamp-query": ".[] | select(.name==$tag) | .commit.created_at"
                    }
                },
                {
                    "type": "shell",
                    "commands": [
                        "sed -i '/find_package(Qt6/ s/${PROJECT_VERSION}/${PROJECT_VERSION_MAJOR}.${PROJECT_VERSION_MINOR}/' $(find . -name CMakeLists.txt)"
                    ]
                },
                {
                    "type": "patch",
                    "paths": [
                        "patch/qtwebengine-flatpak-paths.patch",
                        "patch/flatpak-includedir-dbus.patch",
                        "patch/qtwebengine-Disbale-xnnpack-on-aarch64.patch",
                        "patch/qtwebengine-pipewire-screen.patch",
                        "patch/qtwebengine-pipewire-camera.patch"
                    ]
                },
                {
                    "type": "patch",
                    "paths": [
                        "patch/chromium-add-app-libdir.patch",
                        "patch/chromium-flatpak-add-initial-sandbox-support.patch",
                        "patch/chromium-flatpak-adjust-paths-for-the-sandbox.patch",
                        "patch/chromium-flatpak-expose-widevine-into-the-sandbox.patch"
                    ],
                    "options": [
                        "--directory=src/3rdparty"
                    ]
                }
            ],
            "modules": [
                {
                    "name": "krb5"
                },
                "minizip/minizip.json",
                {
                    "name": "pciutils"
                },
                "python-html5lib/python-html5lib.json",
                "snappy/snappy.json"
            ]
        },
        "qt6-webview/qt6-webview.json",
        {
            "name": "qtgrpc",
            "buildsystem": "cmake-ninja",
            "cleanup-platform": [
                "/bin",
                "/lib/libexec/qtgrpcgen",
                "/lib/libexec/qtprotobufgen"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://files.kde.org/qt/official_releases/qt/6.12/6.12.0/submodules/qtgrpc-everywhere-src-6.12.0.tar.xz",
                    "sha256": "771852c4e5fbeb3d7c3b2a9aacc13db9efe942a46e7d1454ec1f16092ec3ef9c",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 7927,
                        "stable-only": false,
                        "versions": {
                            "<": "6.13.0"
                        },
                        "url-template": "https://files.kde.org/qt/official_releases/qt/6.12/$version/submodules/qtgrpc-everywhere-src-$version.tar.xz"
                    }
                },
                {
                    "type": "patch",
                    "path": "patch/qtgrpc-find_program-paths.patch"
                },
                {
                    "type": "shell",
                    "commands": [
                        "install-licenses.sh"
                    ]
                }
            ],
            "modules": [
                {
                    "name": "grpc",
                    "buildsystem": "cmake-ninja",
                    "config-opts": [
                        "-DgRPC_BUILD_TESTS=OFF",
                        "-DgRPC_BUILD_CODEGEN=ON",
                        "-DgRPC_DOWNLOAD_ARCHIVES=OFF",
                        "-DgRPC_ZLIB_PROVIDER=package",
                        "-DgRPC_SSL_PROVIDER=package",
                        "-DgRPC_ABSL_PROVIDER=package",
                        "-DgRPC_BUILD_GRPC_CSHARP_PLUGIN=OFF",
                        "-DgRPC_BUILD_GRPC_NODE_PLUGIN=OFF",
                        "-DgRPC_BUILD_GRPC_OBJECTIVE_C_PLUGIN=OFF",
                        "-DgRPC_BUILD_GRPC_PHP_PLUGIN=OFF",
                        "-DgRPC_BUILD_GRPC_PYTHON_PLUGIN=OFF",
                        "-DgRPC_BUILD_GRPC_RUBY_PLUGIN=OFF",
                        "-DgRPC_BUILD_GRPCPP_OTEL_PLUGIN=OFF"
                    ],
                    "cleanup": [
                        "/bin/adig",
                        "/bin/ahost",
                        "/include/upb",
                        "/include/google/protobuf",
                        "/include/grpc*",
                        "/include/re2*",
                        "/include/utf8_*.h",
                        "/include/ares*.h",
                        "*.pc",
                        "/lib/*/cmake/utf8_range",
                        "/lib/*/cmake/protobuf",
                        "/lib/*/cmake/c-ares",
                        "/lib/*/cmake/grpc",
                        "/lib/*/cmake/re2",
                        "/share/man",
                        "/share/grpc/roots.pem",
                        "*.a"
                    ],
                    "cleanup-platform": [
                        "/bin/grpc_cpp_plugin",
                        "/bin/protoc*",
                        "/share/grpc",
                        "/lib/cmake/grpc"
                    ],
                    "sources": [
                        {
                            "type": "git",
                            "url": "https://github.com/grpc/grpc",
                            "tag": "v1.85.1",
                            "commit": "558b7e3b09e42e2160018732acbbf56c9094c84d",
                            "x-checker-data": {
                                "type": "git",
                                "tag-pattern": "^(v[\\d.]+)$"
                            }
                        },
                        {
                            "type": "shell",
                            "commands": [
                                "LICENSES='LICENSE' install-licenses.sh"
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "name": "qtsvg",
            "buildsystem": "cmake-ninja",
            "cleanup-platform": [
                "/bin"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://files.kde.org/qt/official_releases/qt/6.12/6.12.0/submodules/qtsvg-everywhere-src-6.12.0.tar.xz",
                    "sha256": "e4ab39534ec97987b1b9b60ef7f4d3253d5912a69f8c713a01753174a4029331",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 7927,
                        "stable-only": false,
                        "versions": {
                            "<": "6.13.0"
                        },
                        "url-template": "https://files.kde.org/qt/official_releases/qt/6.12/$version/submodules/qtsvg-everywhere-src-$version.tar.xz"
                    }
