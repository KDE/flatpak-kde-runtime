            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.qt.io/official_releases/qt/6.10/6.10.0/submodules/qtscxml-everywhere-src-6.10.0.tar.xz",
                    "sha256": "b5946c405fe1e568a8b0589695f9572dfabf85ac9ac8ec3778f9f791e76131e4",
                    "x-checker-data": {
