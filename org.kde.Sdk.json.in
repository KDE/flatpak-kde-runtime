        {
            "name": "qtwayland",
            "buildsystem": "cmake-ninja",
            "cleanup-platform": [
                "/bin"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://files.kde.org/qt/official_releases/qt/6.12/6.12.0/submodules/qtwayland-everywhere-src-6.12.0.tar.xz",
