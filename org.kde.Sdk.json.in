                        },
                        "url-template": "https://download.qt.io/development_releases/qt/6.12/$version/submodules/qttools-everywhere-src-$version.tar.xz"
                    }
                },
                {
                    "type": "shell",
                    "commands": [
                        "install-licenses.sh"
                    ]
                }
            ]
        },
        {
            "name": "qtshadertools",
