                            "<": "6.11.0"
                        },
                        "url-template": "https://download.qt.io/official_releases/qt/6.11/$version/submodules/qttools-everywhere-src-$version.tar.xz"
                    }
                },
                {
                    "type": "shell",
                    "commands": [
                        "install-licenses.sh"
                    ]
                }
            ]
        },
        {
